---
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Rincon mexicano · Mesero</title>
	</head>
	<body>
		<header class="navbar">
			<div class="brand">
				<span class="brand-icon">🧑‍🍳</span>
				<span class="brand-name">Rincon mexicano  <strong>Mesero</strong></span>
			</div>

			<div class="navbar-actions">
				<span class="connection-status" id="connectionStatus" hidden></span>
				<a href="/" class="btn ghost" title="Ver Caja">
					<span class="btn-icon">🧾</span><span class="btn-label"> Ver Caja</span>
				</a>
				<a href="/dashboard" class="btn ghost" title="Dashboard">
					<span class="btn-icon">📊</span><span class="btn-label"> Dashboard</span>
				</a>
				<a href="/productos" class="btn ghost" title="Productos">
					<span class="btn-icon">🍽️</span><span class="btn-label"> Productos</span>
				</a>
			</div>
		</header>

		<main class="waiter-view">
			<section class="table-board" id="tableBoard">
				<h2 class="section-title">Mesas</h2>
				<div class="table-grid" id="tableGrid"></div>
			</section>

			<section class="order-builder" id="orderBuilder" hidden>
				<div class="order-builder-header">
					<button id="backToTablesBtn" class="btn text">← Volver a mesas</button>
					<h2 id="builderTableName">Mesa 1</h2>
					<span class="status-badge" id="builderStatusBadge"></span>
				</div>

				<div class="pos">
					<section class="catalog">
						<input type="search" class="product-search" id="productSearch" placeholder="🔍 Buscar producto…" aria-label="Buscar producto" />
						<div class="category-filters" id="categoryFilters"></div>
						<div class="product-grid" id="productGrid"></div>
						<p class="empty-state" id="productSearchEmpty" hidden>No se encontraron productos.</p>
					</section>

					<aside class="order-panel">
						<div class="order-panel-header">
							<h2>Orden</h2>
							<button id="clearOrderBtn" class="btn text" title="Vaciar orden">Vaciar</button>
						</div>

						<ul class="cart-items" id="cartItems"></ul>
						<p class="order-empty" id="orderEmpty">Agrega productos del menú.</p>

						<div class="order-totals">
							<div class="row">
								<span>Subtotal</span>
								<span id="subtotal">$0.00</span>
							</div>
							<div class="row total">
								<span>Total</span>
								<span id="total">$0.00</span>
							</div>
						</div>

						<button id="sendOrderBtn" class="btn primary charge-btn">Enviar orden a caja</button>
					</aside>
				</div>
			</section>
		</main>

		<div class="toast" id="toast"></div>

		<script>
			import '../scripts/mesero.ts';
		</script>
	</body>
</html>
