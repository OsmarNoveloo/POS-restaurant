---
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Rincon mexicano · Productos</title>
	</head>
	<body>
		<header class="navbar">
			<div class="brand">
				<span class="brand-icon">🍽️</span>
				<span class="brand-name">Rincon mexicano  <strong>Productos</strong></span>
			</div>

			<div class="navbar-actions">
				<a href="/" class="btn ghost" title="Ver Caja">
					<span class="btn-icon">🧾</span><span class="btn-label"> Ver Caja</span>
				</a>
				<a href="/mesero" class="btn ghost" title="Ver Mesero">
					<span class="btn-icon">🧑‍🍳</span><span class="btn-label"> Ver Mesero</span>
				</a>
				<a href="/dashboard" class="btn ghost" title="Dashboard">
					<span class="btn-icon">📊</span><span class="btn-label"> Dashboard</span>
				</a>
			</div>
		</header>

		<main class="dashboard">
			<section class="dashboard-card">
				<h2 class="card-title" id="formTitle">Nuevo producto</h2>
				<form id="productoForm" class="producto-form">
					<div class="form-field">
						<label for="nombre">Nombre</label>
						<input id="nombre" name="nombre" type="text" required />
					</div>
					<div class="form-field">
						<label for="precio">Precio</label>
						<input id="precio" name="precio" type="number" min="0.01" step="0.01" required />
					</div>
					<div class="form-field">
						<label for="categoria">Categoría</label>
						<div class="combo-select" id="categoriaSelect">
							<input id="categoria" name="categoria" type="text" required autocomplete="off" placeholder="Elige o escribe…" />
							<div class="combo-dropdown" id="categoriaDropdown"></div>
						</div>
					</div>
					<div class="form-field">
						<label for="emojiTrigger">Icono (emoji)</label>
						<details class="emoji-select" id="emojiSelect">
							<summary class="emoji-trigger" id="emojiTrigger">
								<span class="emoji-preview empty" id="emojiPreview">🍽️</span>
								<span class="emoji-caret">▾</span>
							</summary>
							<div class="emoji-dropdown" id="emojiPicker"></div>
						</details>
						<input id="icono" name="icono" type="hidden" />
					</div>
					<div class="form-field checkbox-field">
						<label><input id="activo" name="activo" type="checkbox" checked /> Activo</label>
					</div>
					<div class="form-actions">
						<button type="button" id="cancelEditBtn" class="btn secondary" hidden>Cancelar edición</button>
						<button type="submit" id="submitProductoBtn" class="btn primary">Agregar producto</button>
					</div>
				</form>
			</section>

			<section class="dashboard-card">
				<h2 class="card-title">Menú</h2>
				<div class="category-filters" id="activoFilters">
					<button type="button" class="category-chip active" data-filter="todos">Todos</button>
					<button type="button" class="category-chip" data-filter="activos">Activos</button>
					<button type="button" class="category-chip" data-filter="inactivos">Inactivos</button>
				</div>
				<div class="table-scroll">
					<table class="sales-table">
						<thead>
							<tr>
								<th></th>
								<th>Nombre</th>
								<th>Categoría</th>
								<th class="align-right">Precio</th>
								<th>Estado</th>
								<th class="align-right">Acciones</th>
							</tr>
						</thead>
						<tbody id="productosBody"></tbody>
					</table>
				</div>
				<p class="empty-state" id="productosEmpty" hidden>No hay productos que mostrar.</p>
			</section>
		</main>

		<div class="modal-overlay" id="confirmModal">
			<div class="modal">
				<h3>Eliminar producto</h3>
				<p id="confirmMessage">¿Eliminar este producto?</p>
				<div class="modal-actions">
					<button id="confirmCancelBtn" class="btn secondary">Cancelar</button>
					<button id="confirmDeleteBtn" class="btn danger">Eliminar</button>
				</div>
			</div>
		</div>

		<div class="toast" id="toast"></div>

		<script>
			import '../scripts/productos.ts';
		</script>
	</body>
</html>
